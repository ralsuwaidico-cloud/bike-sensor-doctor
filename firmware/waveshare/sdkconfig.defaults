CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Bluetooth LE: NimBLE, central (meter, HR strap) + peripheral (future companion-app sync)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_MEM_SIZE_KILOBYTES=96
CONFIG_LV_USE_OBSERVER=y
# FAT long file names for ride files
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# 0.2.0: Wi-Fi is optional; if switched on its buffers go to PSRAM so the UI and Bluetooth keep internal RAM
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# 0.3.0 Wi-Fi manager: keep Wi-Fi's internal-RAM footprint small so Bluetooth, the UI and ride recording keep theirs
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_TX_BA_WIN=4
# 0.7.3 crash evidence: ESP-IDF core dump to the 'coredump' flash partition (ELF + CRC32), read back at the next boot
# (esp_core_dump_get_summary) into a diagnostic report; the raw dump is kept on the FAT as diag/core-<id>.elf
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=32
# 0.7.3 task stacks (docs/CRASH_0.7.2.md section 3): the NimBLE host task now also runs the sensor manager and the phone
# link tick (all link work on one task); 0.7.2 analysis showed callback paths with log calls at ~3.0-3.4 KB of 4 KB.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=7168
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4608
